# ---- EPIC Review Boost — environment variables ----
# Copy these into Vercel → Project → Settings → Environment Variables.
# Do NOT commit real values; the actual .env is gitignored.

# Supabase Transaction pooler (port 6543) — app runtime.
# For Vercel (serverless) keep connection_limit low.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase direct/session connection (port 5432) — migrations only.
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# Public URL of the deployed app — QR codes and tracked links encode this.
# Set to your Vercel production URL (e.g. https://epic-review-boost.vercel.app).
NEXT_PUBLIC_BASE_URL="https://<your-app>.vercel.app"

# Admin login. Use a strong password in production.
ADMIN_EMAIL="admin@epictoyota.in"
ADMIN_PASSWORD="<set-a-strong-password>"

# Signs the admin session cookie. Use a long random string (generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET="<long-random-string>"
